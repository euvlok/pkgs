{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["scripts/**/*.ts", "tests/**/*.ts"]
}
